<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Colors.xaml" />
    <ResourceDictionary Source="Typography.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- ============ Material Design 3 现代中等密度布局令牌 ============ -->
  <sys:String x:Key="Density.Profile">md3-medium</sys:String>
  <sys:Double x:Key="Layout.ControlHeight">30</sys:Double>
  <sys:Double x:Key="Layout.ControlHeight.Small">28</sys:Double>
  <sys:Double x:Key="Layout.ControlHeight.Large">36</sys:Double>
  <sys:Double x:Key="Layout.MultilineMinHeight">56</sys:Double>
  <sys:Double x:Key="Layout.InputMinHeight">56</sys:Double>
  <sys:Double x:Key="Layout.InputMaxHeight">168</sys:Double>
  <sys:Double x:Key="Layout.LogMinHeight">80</sys:Double>
  <sys:Double x:Key="Layout.LogMaxHeight">220</sys:Double>
  <sys:Double x:Key="Layout.TagHeight">24</sys:Double>
  <sys:Double x:Key="Layout.IconButton.Small">28</sys:Double>
  <sys:Double x:Key="Layout.IconButton.Micro">24</sys:Double>
  <sys:Double x:Key="Layout.IconButton.Large">32</sys:Double>
  <sys:Double x:Key="Layout.HeaderHeight">30</sys:Double>
  <sys:Double x:Key="Layout.RowHeight">28</sys:Double>
  <sys:Double x:Key="Layout.CellControlHeight">24</sys:Double>
  <sys:Double x:Key="Layout.ProgressBarHeight">6</sys:Double>
  <sys:Double x:Key="Layout.ExpanderMaxHeight">320</sys:Double>
  <sys:Double x:Key="Layout.CheckBox.Size">16</sys:Double>
  <sys:Double x:Key="Layout.ButtonMinWidth">64</sys:Double>
  <sys:Double x:Key="Layout.ButtonMinWidth.Small">48</sys:Double>
  <sys:Double x:Key="Layout.FormLabelMinWidth">80</sys:Double>
  <sys:Double x:Key="Layout.FormLabelMaxWidth">132</sys:Double>
  <sys:Double x:Key="Layout.InputMinWidth">140</sys:Double>
  <sys:Double x:Key="Layout.WindowMinWidth">520</sys:Double>

  <Thickness x:Key="Layout.WindowPadding">12</Thickness>
  <Thickness x:Key="Layout.GroupPadding">10</Thickness>
  <Thickness x:Key="Layout.CardPadding">12</Thickness>
  <Thickness x:Key="Layout.FormRowMargin">0,3,0,3</Thickness>
  <Thickness x:Key="Layout.ListItemPadding">10,6</Thickness>
  <Thickness x:Key="Layout.ListViewItemPadding">4,2</Thickness>
  <Thickness x:Key="Layout.MenuItemPadding">10,6</Thickness>
  <Thickness x:Key="Layout.TabPadding">14,7</Thickness>
  <Thickness x:Key="Layout.ButtonPadding">14,0</Thickness>
  <Thickness x:Key="Layout.ButtonPadding.Small">10,0</Thickness>
  <Thickness x:Key="Layout.InputPadding">8,0</Thickness>
  <Thickness x:Key="Layout.MultilinePadding">8,6</Thickness>
  <Thickness x:Key="Layout.InputPadding.Multiline">8,6</Thickness>
  <Thickness x:Key="Layout.ComboBoxPadding">8,0,24,0</Thickness>
  <Thickness x:Key="Layout.ComboBoxItemPadding">8,5</Thickness>
  <Thickness x:Key="Layout.DatePickerPadding">8,0,26,0</Thickness>
  <Thickness x:Key="Layout.TooltipPadding">8,4</Thickness>
  <Thickness x:Key="Layout.BadgePadding">10,2</Thickness>
  <Thickness x:Key="Layout.ExpanderHeaderPadding">10,5</Thickness>
  <Thickness x:Key="Layout.ExpanderContentPadding">10,6</Thickness>
  <Thickness x:Key="Layout.ToolBarPadding">6,4</Thickness>
  <sys:Double x:Key="Layout.ToolBarHeight">42</sys:Double>
  <Thickness x:Key="Layout.ButtonBarMargin">0,10,0,0</Thickness>
  <Thickness x:Key="Layout.SectionMargin">0,0,0,8</Thickness>
  <Thickness x:Key="Layout.ButtonGap">0,0,8,0</Thickness>
  <GridLength x:Key="Layout.ColumnGap">8</GridLength>

  <!-- MD3 Shape 圆角体系：Small 8 / Input 12 / Card 16 / Pill 全胶囊 -->
  <CornerRadius x:Key="Radius.Small">8</CornerRadius>
  <CornerRadius x:Key="Radius.Input">12</CornerRadius>
  <CornerRadius x:Key="Radius.Card">16</CornerRadius>
  <CornerRadius x:Key="Radius.Pill">14</CornerRadius>

  <!-- 图标尺寸阶梯 -->
  <sys:Double x:Key="Icon.Size.Micro">12</sys:Double>
  <sys:Double x:Key="Icon.Size.Small">15</sys:Double>
  <sys:Double x:Key="Icon.Size.Regular">16</sys:Double>
  <sys:Double x:Key="Icon.Size.Medium">20</sys:Double>
  <sys:Double x:Key="Icon.Size.Large">24</sys:Double>

  <!-- 滚动条（MD3 圆润细窄） -->
  <Style x:Key="ScrollBar.Thumb" TargetType="{x:Type Thumb}">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="MinWidth" Value="28" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Border x:Name="Bd" Background="{StaticResource Brush.ScrollThumb}" CornerRadius="3" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.ScrollThumb.Hover}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ScrollBar.PageButton" TargetType="{x:Type RepeatButton}">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type ScrollBar}">
    <Setter Property="Width" Value="12" />
    <Setter Property="MinWidth" Value="12" />
    <Setter Property="Padding" Value="3,0,3,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ScrollBar}">
          <Grid Background="Transparent" SnapsToDevicePixels="True">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource ScrollBar.PageButton}" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Margin="{TemplateBinding Padding}" Style="{StaticResource ScrollBar.Thumb}" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource ScrollBar.PageButton}" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
              <Setter TargetName="PART_Track" Property="Orientation" Value="Horizontal" />
              <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
              <Setter Property="Padding" Value="0,3,0,3" />
              <Setter Property="Width" Value="Auto" />
              <Setter Property="MinWidth" Value="0" />
              <Setter Property="Height" Value="12" />
              <Setter Property="MinHeight" Value="12" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 滚动容器 -->
  <Style x:Key="ScrollViewer.Base" TargetType="{x:Type ScrollViewer}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- 窗口基样式 -->
  <Style x:Key="Window.Base" TargetType="{x:Type Window}">
    <Setter Property="Background" Value="{StaticResource Brush.WindowBackground}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    <Setter Property="UseLayoutRounding" Value="True" />
  </Style>

  <!-- 键盘焦点框 -->
  <Style x:Key="FocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border BorderBrush="{StaticResource Brush.Focus}"
                  BorderThickness="2"
                  CornerRadius="{StaticResource Radius.Pill}"
                  SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 分隔线 -->
  <Style x:Key="Rule" TargetType="{x:Type Border}">
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Margin" Value="0,10,0,6" />
  </Style>
</ResourceDictionary>
