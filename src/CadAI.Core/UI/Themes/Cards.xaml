<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Colors.xaml" />
    <ResourceDictionary Source="Typography.xaml" />
    <ResourceDictionary Source="Layout.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- ============ MD3 卡片与面板 ============ -->
  <Style x:Key="Card.Base" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{StaticResource Brush.Panel}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Card.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
    <Setter Property="Padding" Value="{DynamicResource Layout.CardPadding}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- MD3 Dark Elevated Surface：深色柔和阴影 + 清晰微亮轮廓 -->
  <Style x:Key="Card.Elevated" TargetType="{x:Type Border}" BasedOn="{StaticResource Card.Base}">
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Strong}" />
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.32" Color="{StaticResource Color.Shadow}" />
      </Setter.Value>
    </Setter>
  </Style>

  <!-- MD3 Tonal 说明卡片 -->
  <Style x:Key="Card.Info" TargetType="{x:Type Border}" BasedOn="{StaticResource Card.Base}">
    <Setter Property="Background" Value="{StaticResource Brush.Card.System}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- 工具调用 / 代码块 -->
  <Style x:Key="Card.Tool" TargetType="{x:Type Border}" BasedOn="{StaticResource Card.Base}">
    <Setter Property="Background" Value="{StaticResource Brush.Code.Background}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Input}" />
    <Setter Property="Padding" Value="{DynamicResource Layout.GroupPadding}" />
  </Style>

  <!-- MD3 浮层（历史记录等） -->
  <Style x:Key="Card.Flyout" TargetType="{x:Type Border}" BasedOn="{StaticResource Card.Base}">
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
    <Setter Property="Padding" Value="{DynamicResource Layout.GroupPadding}" />
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.14" Color="{StaticResource Color.Shadow}" />
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 折叠区（思考过程 / 工具详情） -->
  <Style x:Key="Expander.Header" TargetType="{x:Type ToggleButton}">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Border x:Name="Bd" Background="Transparent" Padding="6,3" CornerRadius="{StaticResource Radius.Small}">
            <StackPanel Orientation="Horizontal">
              <Path x:Name="Arrow"
                    VerticalAlignment="Center"
                    Margin="0,1,6,0"
                    Data="M 0,0 L 4,4 L 0,8"
                    Stroke="{StaticResource Brush.Text.Secondary}"
                    StrokeThickness="1.5"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                  <RotateTransform Angle="0" />
                </Path.RenderTransform>
              </Path>
              <ContentPresenter VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Control.Hover}" />
              <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Arrow" Property="RenderTransform">
                <Setter.Value>
                  <RotateTransform Angle="90" />
                </Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Expander.Subtle" TargetType="{x:Type Expander}">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Expander}">
          <StackPanel>
            <ToggleButton x:Name="HeaderButton"
                          Style="{StaticResource Expander.Header}"
                          Content="{TemplateBinding Header}"
                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
            <ScrollViewer x:Name="ContentScroll"
                          Visibility="Collapsed"
                          Margin="0,6,0,0"
                          MaxHeight="{DynamicResource Layout.ExpanderMaxHeight}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
              <ContentPresenter x:Name="ContentSite" />
            </ScrollViewer>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
              <Setter TargetName="ContentScroll" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 指标标签 -->
  <Style x:Key="Card.MetricTag" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{StaticResource Brush.MutedPanel}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Height" Value="{DynamicResource Layout.TagHeight}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="Badge.Pill" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{StaticResource Brush.Accent.Subtle}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="Badge.Pill.Neutral" TargetType="{x:Type Border}" BasedOn="{StaticResource Badge.Pill}">
    <Setter Property="Background" Value="{StaticResource Brush.MutedPanel}" />
  </Style>

  <Style x:Key="Card.MetricTag.Accent" TargetType="{x:Type Border}" BasedOn="{StaticResource Card.MetricTag}">
    <Setter Property="Background" Value="{StaticResource Brush.Accent.Subtle}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
</ResourceDictionary>
