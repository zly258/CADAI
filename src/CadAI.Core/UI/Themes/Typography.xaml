<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Colors.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- 全局统一字体：正文、代码、Schema、Markdown、日志、弹层与表单共用同一字体栈。 -->
  <FontFamily x:Key="Font.Ui">Microsoft YaHei UI, Microsoft YaHei, Segoe UI</FontFamily>

  <!-- 紧凑字号阶梯：与 wpf-ui-style 规范一致。 -->
  <sys:Double x:Key="FontSize.Title">13</sys:Double>
  <sys:Double x:Key="FontSize.Section">13</sys:Double>
  <sys:Double x:Key="FontSize.Body">12</sys:Double>
  <sys:Double x:Key="FontSize.Caption">11.5</sys:Double>
  <!-- 仅产品名 / 关于页主标题使用，避免业务窗口为一个大标题新造字号。 -->
  <sys:Double x:Key="FontSize.Display">16</sys:Double>
  <!-- 附件缩略图角标 / 胶囊里的文件名等"比 Caption 更小"的场景。仍须 ≥3:1 对比度，不用于正文。 -->
  <sys:Double x:Key="FontSize.Micro">10</sys:Double>

  <!-- 页面/面板标题：13px、常规字重、深色正文色。 -->
  <Style x:Key="Text.Title" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Title}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- 一级分区标题：与标题同级，仅用于 GroupBox / 详情页区块。 -->
  <Style x:Key="Text.Section" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Section}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="Text.Body" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="18" />
  </Style>

  <Style x:Key="Text.Caption" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="17" />
  </Style>

  <!-- 表单标签：正文色、正文号、单行、与右侧控件垂直居中。 -->
  <Style x:Key="Text.Label" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>

  <!-- 危险提示文本：仅改变颜色，不加粗。 -->
  <Style x:Key="Text.Caption.Danger" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Caption}">
    <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
  </Style>

  <!-- 消息角色标签的胶囊内文字：字号与半粗在这里统一。
       胶囊本体（底色/圆角/前景）在 UI/Controls/MessageCard.xaml 的 Text.Role.*。 -->
  <Style x:Key="Text.RoleText" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="Text.Code" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="17" />
  </Style>
</ResourceDictionary>
