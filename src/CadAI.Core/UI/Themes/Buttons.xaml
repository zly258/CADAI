<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Colors.xaml" />
    <ResourceDictionary Source="Typography.xaml" />
    <ResourceDictionary Source="Layout.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- ============ MD3 胶囊按钮统一模板 ============ -->
  <ControlTemplate x:Key="Button.Template" TargetType="{x:Type Button}">
    <Border x:Name="Bd"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{StaticResource Radius.Pill}"
            SnapsToDevicePixels="True">
      <ContentPresenter Margin="{TemplateBinding Padding}"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        RecognizesAccessKey="True" />
    </Border>
  </ControlTemplate>

  <Style x:Key="Button.Base" TargetType="{x:Type Button}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="Height" Value="{DynamicResource Layout.ControlHeight}" />
    <Setter Property="MinWidth" Value="{DynamicResource Layout.ButtonMinWidth}" />
    <Setter Property="Padding" Value="{DynamicResource Layout.ButtonPadding}" />
    <Setter Property="Background" Value="{StaticResource Brush.Control}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Control}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template" Value="{StaticResource Button.Template}" />
  </Style>

  <!-- MD3 Filled Primary 按钮：实心主色胶囊 + 纯白文字/图标 -->
  <Style x:Key="Button.Primary" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.Accent.Hover}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent.Hover}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.Accent.Pressed}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent.Pressed}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="{StaticResource Brush.Control.Disabled}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
        <Setter Property="Cursor" Value="Arrow" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- MD3 Dark Filled Tonal 按钮：深蓝容器底 + 亮蓝字/图标 -->
  <Style x:Key="Button.Tonal" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="{StaticResource Brush.Accent.Subtle}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Focus}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.Accent.SubtleHover}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="{StaticResource Brush.Control.Disabled}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
        <Setter Property="Cursor" Value="Arrow" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- MD3 Outlined 次要按钮：白底 + 清晰描边 -->
  <Style x:Key="Button.Secondary" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Base}">
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.Control.Hover}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.Control.Pressed}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent.Pressed}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="{StaticResource Brush.Control.Disabled}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
        <Setter Property="Cursor" Value="Arrow" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- MD3 Text 文本/图标按钮：透明底、悬停柔和胶囊底 -->
  <Style x:Key="Button.Text" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="{DynamicResource Layout.ButtonPadding.Small}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.Control.Hover}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.Control.Pressed}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
        <Setter Property="Cursor" Value="Arrow" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- MD3 Danger 按钮：柔和红容器/红边 -->
  <Style x:Key="Button.Danger" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="{StaticResource Brush.Danger.Subtle}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Danger}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.Danger}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Danger}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.Danger.Hover}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Danger.Hover}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="{StaticResource Brush.Control.Disabled}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
        <Setter Property="Cursor" Value="Arrow" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ============ 小号胶囊按钮 ============ -->
  <Style x:Key="Button.Primary.Small" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Primary}">
    <Setter Property="Height" Value="{DynamicResource Layout.ControlHeight.Small}" />
    <Setter Property="MinWidth" Value="{DynamicResource Layout.ButtonMinWidth.Small}" />
    <Setter Property="Padding" Value="{DynamicResource Layout.ButtonPadding.Small}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
  </Style>

  <Style x:Key="Button.Tonal.Small" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Tonal}">
    <Setter Property="Height" Value="{DynamicResource Layout.ControlHeight.Small}" />
    <Setter Property="MinWidth" Value="{DynamicResource Layout.ButtonMinWidth.Small}" />
    <Setter Property="Padding" Value="{DynamicResource Layout.ButtonPadding.Small}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
  </Style>

  <Style x:Key="Button.Secondary.Small" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Secondary}">
    <Setter Property="Height" Value="{DynamicResource Layout.ControlHeight.Small}" />
    <Setter Property="MinWidth" Value="{DynamicResource Layout.ButtonMinWidth.Small}" />
    <Setter Property="Padding" Value="{DynamicResource Layout.ButtonPadding.Small}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
  </Style>

  <Style x:Key="Button.Text.Small" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Text}">
    <Setter Property="Height" Value="{DynamicResource Layout.ControlHeight.Small}" />
    <Setter Property="Padding" Value="{DynamicResource Layout.ButtonPadding.Small}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
  </Style>

  <Style x:Key="Button.Danger.Small" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Danger}">
    <Setter Property="Height" Value="{DynamicResource Layout.ControlHeight.Small}" />
    <Setter Property="MinWidth" Value="{DynamicResource Layout.ButtonMinWidth.Small}" />
    <Setter Property="Padding" Value="{DynamicResource Layout.ButtonPadding.Small}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
  </Style>

  <!-- 历史记录标题按钮 -->
  <Style x:Key="Button.Title" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Height" Value="Auto" />
    <Setter Property="MinHeight" Value="{DynamicResource Layout.ControlHeight.Small}" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.Control.Hover}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.Control.Pressed}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- 参数行删除按钮 -->
  <Style x:Key="Button.RowAction" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Text.Small}">
    <Setter Property="Width" Value="{DynamicResource Layout.IconButton.Small}" />
    <Setter Property="MinWidth" Value="{DynamicResource Layout.IconButton.Small}" />
    <Setter Property="Height" Value="{DynamicResource Layout.IconButton.Small}" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.Danger.Subtle}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- 附件缩略图移除钮 -->
  <Style x:Key="Button.RemoveChip" TargetType="{x:Type Button}">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource Brush.OverlayChip.Glyph}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="Chip"
                  Background="{StaticResource Brush.OverlayChip}"
                  CornerRadius="9"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="False" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chip" Property="Background" Value="{StaticResource Brush.OverlayChip.Hover}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ============ MD3 圆形纯图标按钮（30×30，用于对话顶栏与输入工具栏） ============ -->
  <Style x:Key="Button.Icon" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Text}">
    <Setter Property="Width" Value="{DynamicResource Layout.ControlHeight}" />
    <Setter Property="Height" Value="{DynamicResource Layout.ControlHeight}" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
  </Style>

  <Style x:Key="Button.Icon.Tonal" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Tonal}">
    <Setter Property="Width" Value="{DynamicResource Layout.ControlHeight}" />
    <Setter Property="Height" Value="{DynamicResource Layout.ControlHeight}" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style x:Key="Button.Icon.Primary" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Primary}">
    <Setter Property="Width" Value="{DynamicResource Layout.ControlHeight}" />
    <Setter Property="Height" Value="{DynamicResource Layout.ControlHeight}" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style x:Key="Button.Icon.Danger" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Danger}">
    <Setter Property="Width" Value="{DynamicResource Layout.ControlHeight}" />
    <Setter Property="Height" Value="{DynamicResource Layout.ControlHeight}" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <!-- 圆形微型图标按钮（MD3 Icon Button） -->
  <Style x:Key="Button.Icon.Micro" TargetType="{x:Type Button}">
    <Setter Property="Width" Value="{DynamicResource Layout.IconButton.Micro}" />
    <Setter Property="Height" Value="{DynamicResource Layout.IconButton.Micro}" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="12"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="False" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Control.Hover}" />
              <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Control.Pressed}" />
              <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Background" Value="Transparent" />
              <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 圆形危险微型图标按钮 -->
  <Style x:Key="Button.Icon.Micro.Danger" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Icon.Micro}">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="12"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="False" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Danger.Subtle}" />
              <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Danger.Subtle}" />
              <Setter Property="Foreground" Value="{StaticResource Brush.Danger.Hover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Background" Value="Transparent" />
              <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 轻量幽灵文字按钮 -->
  <Style x:Key="Button.Subtle.Small" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Height" Value="{DynamicResource Layout.ControlHeight.Small}" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.Control.Hover}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.Control.Pressed}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
