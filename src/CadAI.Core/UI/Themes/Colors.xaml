<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============ Material Design 3 中灰暗色令牌（非纯黑，高辨识度清晰边框） ============ -->
  <!-- 柔和炭灰画布 + 分层浮起面板 + 明确可见边框，长时间在 AutoCAD 中阅读不刺眼、边界不发糊 -->
  <Color x:Key="Color.WindowBackground">#FF24262B</Color>
  <Color x:Key="Color.Panel">#FF2D3036</Color>
  <Color x:Key="Color.MutedPanel">#FF363A42</Color>
  <Color x:Key="Color.Border">#FF4A4F5A</Color>
  <Color x:Key="Color.BorderStrong">#FF5C6270</Color>
  <Color x:Key="Color.BorderControl">#FF676E7D</Color>

  <!-- On-Surface 文字色阶 -->
  <Color x:Key="Color.TextPrimary">#FFF0F2F5</Color>
  <Color x:Key="Color.TextSecondary">#FFB0B7C3</Color>
  <!-- 禁用文字对禁用底（4.17:1）及窗口底（5.17:1）均满足 WCAG ≥ 3:1 -->
  <Color x:Key="Color.TextDisabled">#FF9098A6</Color>

  <!-- Primary 强调色与容器 -->
  <Color x:Key="Color.Accent">#FF3B82F6</Color>
  <Color x:Key="Color.AccentHover">#FF5593F8</Color>
  <Color x:Key="Color.AccentPressed">#FF2563EB</Color>
  <Color x:Key="Color.AccentSubtle">#FF253B5E</Color>
  <Color x:Key="Color.Selection">#FF2A4268</Color>
  <Color x:Key="Color.SelectionHover">#FF324F7C</Color>
  <Color x:Key="Color.Focus">#FF60A5FA</Color>
  <Color x:Key="Color.OnAccent">#FFFFFFFF</Color>

  <!-- Danger 语义色 -->
  <Color x:Key="Color.Danger">#FFF2645D</Color>
  <Color x:Key="Color.DangerHover">#FFDC463E</Color>
  <Color x:Key="Color.DangerSubtle">#FF47272B</Color>

  <!-- 交互态与输入凹槽底色 -->
  <Color x:Key="Color.ControlHover">#FF3A3E47</Color>
  <Color x:Key="Color.ControlPressed">#FF454A55</Color>
  <Color x:Key="Color.ControlDisabled">#FF32353C</Color>
  <Color x:Key="Color.CodeBackground">#FF1F2126</Color>
  <Color x:Key="Color.CardBorder">#FF4A4F5A</Color>

  <!-- 消息气泡底色 -->
  <Color x:Key="Color.CardSystem">#FF32363E</Color>
  <Color x:Key="Color.CardUser">#FF28436A</Color>
  <Color x:Key="Color.CardAi">#FF2D3036</Color>
  <Color x:Key="Color.CardError">#FF47272B</Color>

  <!-- 状态语义色 -->
  <Color x:Key="Color.Success">#FF4ADE80</Color>
  <Color x:Key="Color.SuccessSubtle">#FF1F3D2E</Color>
  <Color x:Key="Color.Warning">#FFFBBF24</Color>
  <Color x:Key="Color.WarningSubtle">#FF42341B</Color>

  <!-- 规范标准徽章别名 -->
  <Color x:Key="Color.BadgeIdleForeground">#FFB0B7C3</Color>
  <Color x:Key="Color.BadgeIdleBackground">#FF363A42</Color>
  <Color x:Key="Color.BadgeActiveForeground">#FF60A5FA</Color>
  <Color x:Key="Color.BadgeActiveBackground">#FF253B5E</Color>
  <Color x:Key="Color.BadgeDoneForeground">#FF4ADE80</Color>
  <Color x:Key="Color.BadgeDoneBackground">#FF1F3D2E</Color>
  <Color x:Key="Color.BadgeStoppedForeground">#FFFBBF24</Color>
  <Color x:Key="Color.BadgeStoppedBackground">#FF42341B</Color>
  <Color x:Key="Color.BadgeFailedForeground">#FFF2645D</Color>
  <Color x:Key="Color.BadgeFailedBackground">#FF47272B</Color>

  <!-- 滚动条拇指 -->
  <Color x:Key="Color.ScrollThumb">#FF5A6170</Color>
  <Color x:Key="Color.ScrollThumbHover">#FF737B8D</Color>

  <!-- Surface 别名 -->
  <Color x:Key="Color.Surface">#FF2D3036</Color>
  <Color x:Key="Color.SurfaceAlt">#FF363A42</Color>
  <Color x:Key="Color.SurfaceSunken">#FF24262B</Color>
  <Color x:Key="Color.AccentSubtleHover">#FF324F7C</Color>
  <Color x:Key="Color.DangerPressed">#FFB8322B</Color>

  <!-- 附件缩略图浮层移除钮 -->
  <Color x:Key="Color.OverlayChip">#D924262B</Color>
  <Color x:Key="Color.OverlayChipGlyph">#FFF0F2F5</Color>
  <Color x:Key="Color.OverlayChipHover">#F2DC463E</Color>

  <!-- ToolTip -->
  <Color x:Key="Color.Tooltip.Foreground">#FFF4F6FA</Color>
  <Color x:Key="Color.Tooltip.Background">#FF3E424C</Color>
  <Color x:Key="Color.TooltipForeground">#FFF4F6FA</Color>
  <Color x:Key="Color.TooltipBackground">#FF3E424C</Color>

  <!-- 阴影色 -->
  <Color x:Key="Color.Shadow">#FF101216</Color>

  <!-- ============ 画刷 ============ -->
  <SolidColorBrush x:Key="Brush.WindowBackground" Color="{StaticResource Color.WindowBackground}" />
  <SolidColorBrush x:Key="Brush.Panel" Color="{StaticResource Color.Panel}" />
  <SolidColorBrush x:Key="Brush.MutedPanel" Color="{StaticResource Color.MutedPanel}" />
  <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
  <SolidColorBrush x:Key="Brush.Border.Strong" Color="{StaticResource Color.BorderStrong}" />
  <SolidColorBrush x:Key="Brush.Border.Control" Color="{StaticResource Color.BorderControl}" />

  <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.TextPrimary}" />
  <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.TextSecondary}" />
  <SolidColorBrush x:Key="Brush.Text.Disabled" Color="{StaticResource Color.TextDisabled}" />

  <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
  <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{StaticResource Color.AccentHover}" />
  <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="{StaticResource Color.AccentPressed}" />
  <SolidColorBrush x:Key="Brush.Accent.Subtle" Color="{StaticResource Color.AccentSubtle}" />
  <SolidColorBrush x:Key="Brush.Selection" Color="{StaticResource Color.Selection}" />
  <SolidColorBrush x:Key="Brush.Selection.Hover" Color="{StaticResource Color.SelectionHover}" />
  <SolidColorBrush x:Key="Brush.Focus" Color="{StaticResource Color.Focus}" />
  <SolidColorBrush x:Key="Brush.OnAccent" Color="{StaticResource Color.OnAccent}" />

  <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
  <SolidColorBrush x:Key="Brush.Danger.Hover" Color="{StaticResource Color.DangerHover}" />
  <SolidColorBrush x:Key="Brush.Danger.Subtle" Color="{StaticResource Color.DangerSubtle}" />

  <!-- 输入框使用微深凹槽底色，与面板表面形成清晰层次 -->
  <SolidColorBrush x:Key="Brush.Control" Color="{StaticResource Color.CodeBackground}" />
  <SolidColorBrush x:Key="Brush.Control.Hover" Color="{StaticResource Color.ControlHover}" />
  <SolidColorBrush x:Key="Brush.Control.Pressed" Color="{StaticResource Color.ControlPressed}" />
  <SolidColorBrush x:Key="Brush.Control.Disabled" Color="{StaticResource Color.ControlDisabled}" />
  <SolidColorBrush x:Key="Brush.Code.Background" Color="{StaticResource Color.CodeBackground}" />
  <SolidColorBrush x:Key="Brush.Card.Border" Color="{StaticResource Color.CardBorder}" />

  <SolidColorBrush x:Key="Brush.Card.System" Color="{StaticResource Color.CardSystem}" />
  <SolidColorBrush x:Key="Brush.Card.User" Color="{StaticResource Color.CardUser}" />
  <SolidColorBrush x:Key="Brush.Card.Ai" Color="{StaticResource Color.CardAi}" />
  <SolidColorBrush x:Key="Brush.Card.Error" Color="{StaticResource Color.CardError}" />

  <SolidColorBrush x:Key="Brush.ScrollThumb" Color="{StaticResource Color.ScrollThumb}" />
  <SolidColorBrush x:Key="Brush.ScrollThumb.Hover" Color="{StaticResource Color.ScrollThumbHover}" />

  <SolidColorBrush x:Key="Brush.Tooltip.Background" Color="{StaticResource Color.Tooltip.Background}" />
  <SolidColorBrush x:Key="Brush.Tooltip.Foreground" Color="{StaticResource Color.Tooltip.Foreground}" />

  <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
  <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{StaticResource Color.SurfaceAlt}" />
  <SolidColorBrush x:Key="Brush.SurfaceSunken" Color="{StaticResource Color.SurfaceSunken}" />
  <SolidColorBrush x:Key="Brush.Accent.SubtleHover" Color="{StaticResource Color.AccentSubtleHover}" />
  <SolidColorBrush x:Key="Brush.Danger.Pressed" Color="{StaticResource Color.DangerPressed}" />
  <SolidColorBrush x:Key="Brush.OverlayChip" Color="{StaticResource Color.OverlayChip}" />
  <SolidColorBrush x:Key="Brush.OverlayChip.Glyph" Color="{StaticResource Color.OverlayChipGlyph}" />
  <SolidColorBrush x:Key="Brush.OverlayChip.Hover" Color="{StaticResource Color.OverlayChipHover}" />

  <!-- 状态标签画刷 -->
  <SolidColorBrush x:Key="Brush.Badge.Idle.Background" Color="{StaticResource Color.BadgeIdleBackground}" />
  <SolidColorBrush x:Key="Brush.Badge.Idle.Foreground" Color="{StaticResource Color.BadgeIdleForeground}" />
  <SolidColorBrush x:Key="Brush.Badge.Active.Background" Color="{StaticResource Color.BadgeActiveBackground}" />
  <SolidColorBrush x:Key="Brush.Badge.Active.Foreground" Color="{StaticResource Color.BadgeActiveForeground}" />
  <SolidColorBrush x:Key="Brush.Badge.Done.Background" Color="{StaticResource Color.BadgeDoneBackground}" />
  <SolidColorBrush x:Key="Brush.Badge.Done.Foreground" Color="{StaticResource Color.BadgeDoneForeground}" />
  <SolidColorBrush x:Key="Brush.Badge.Stopped.Background" Color="{StaticResource Color.BadgeStoppedBackground}" />
  <SolidColorBrush x:Key="Brush.Badge.Stopped.Foreground" Color="{StaticResource Color.BadgeStoppedForeground}" />
  <SolidColorBrush x:Key="Brush.Badge.Failed.Background" Color="{StaticResource Color.BadgeFailedBackground}" />
  <SolidColorBrush x:Key="Brush.Badge.Failed.Foreground" Color="{StaticResource Color.BadgeFailedForeground}" />
</ResourceDictionary>
