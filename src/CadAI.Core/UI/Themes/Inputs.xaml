<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Colors.xaml" />
    <ResourceDictionary Source="Typography.xaml" />
    <ResourceDictionary Source="Layout.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- =========================================================================
       单行输入框：高度 30、圆角 2、内容垂直居中。
       默认只显示中性边框，仅键盘焦点时才显示 Accent 边框。
       ========================================================================= -->
  <ControlTemplate x:Key="TextBox.SingleLine.Template" TargetType="{x:Type TextBox}">
    <Border x:Name="Bd"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{StaticResource Radius.Small}"
            SnapsToDevicePixels="True">
      <ScrollViewer x:Name="PART_ContentHost"
                    Focusable="False"
                    Margin="{TemplateBinding Padding}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                    VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
      </Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Focus}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Control.Disabled}" />
        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <!-- =========================================================================
       多行输入框（聊天输入区 / 文本域）：圆角 4、内容垂直靠上。
       ========================================================================= -->
  <ControlTemplate x:Key="TextBox.Multiline.Template" TargetType="{x:Type TextBox}">
    <Border x:Name="Bd"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{StaticResource Radius.Input}"
            SnapsToDevicePixels="True">
      <ScrollViewer x:Name="PART_ContentHost"
                    Focusable="False"
                    Margin="{TemplateBinding Padding}"
                    HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                    VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
      </Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Focus}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Control.Disabled}" />
        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <!-- 只读代码 / Schema 预览框：圆角 2、中性边框，与普通输入框同一焦点规则。 -->
  <ControlTemplate x:Key="TextBox.Code.Template" TargetType="{x:Type TextBox}">
    <Border x:Name="Bd"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{StaticResource Radius.Small}"
            SnapsToDevicePixels="True">
      <ScrollViewer x:Name="PART_ContentHost"
                    Focusable="False"
                    Margin="{TemplateBinding Padding}"
                    HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                    VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
      </Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Focus}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <!-- 密码框与普通输入框视觉完全一致。 -->
  <ControlTemplate x:Key="PasswordBox.Template" TargetType="{x:Type PasswordBox}">
    <Border x:Name="Bd"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{StaticResource Radius.Small}"
            SnapsToDevicePixels="True">
      <ScrollViewer x:Name="PART_ContentHost"
                    Focusable="False"
                    Margin="{TemplateBinding Padding}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
      </Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Focus}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Control.Disabled}" />
        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <!-- ============ 输入框样式 ============ -->
  <Style x:Key="TextBox.Base" TargetType="{x:Type TextBox}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    <Setter Property="Background" Value="{StaticResource Brush.Control}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Control}" />
    <Setter Property="BorderThickness" Value="1" />
    <!-- 固定高度：与按钮 / 下拉框严格一致（模板内滚动区会额外预留厚度，不能只靠 MinHeight） -->
    <Setter Property="Height" Value="{DynamicResource Layout.ControlHeight}" />
    <Setter Property="MinHeight" Value="{DynamicResource Layout.ControlHeight}" />
    <!-- 单行输入：紧凑档左右留 6，文字用完整内高垂直居中。 -->
    <Setter Property="Padding" Value="{DynamicResource Layout.InputPadding}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="CaretBrush" Value="{StaticResource Brush.Text.Primary}" />
    <Setter Property="SelectionBrush" Value="{StaticResource Brush.Accent}" />
    <!-- 模板自己会在聚焦时把边框换成 Accent，再叠 FocusVisual 的焦点框就是"双边框"。
         输入类控件一律不要系统焦点框，只保留边框变色这一种焦点表达。 -->
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template" Value="{StaticResource TextBox.SingleLine.Template}" />
    <Style.Triggers>
      <!-- 只读不是禁用：内容仍可读可复制，但底色与边框要明确告诉用户"这里不能编辑"。
           业务窗口不再各自内联 Background=MutedPanel。 -->
      <Trigger Property="IsReadOnly" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.MutedPanel}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- 多行文本域：自动换行、自适应起步高度（随输入内容伸展，上限由 MaxHeight 约束） -->
  <Style x:Key="TextBox.Multiline" TargetType="{x:Type TextBox}" BasedOn="{StaticResource TextBox.Base}">
    <Setter Property="Height" Value="Auto" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MaxHeight" Value="{DynamicResource Layout.InputMaxHeight}" />
    <Setter Property="Padding" Value="{DynamicResource Layout.MultilinePadding}" />
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="Template" Value="{StaticResource TextBox.Multiline.Template}" />
  </Style>

  <!-- 只读 Schema / Markdown / 工具结果框：统一 UI 字体，不使用等宽字体。 -->
  <Style x:Key="TextBox.Code" TargetType="{x:Type TextBox}" BasedOn="{StaticResource TextBox.Multiline}">
    <Setter Property="Background" Value="{StaticResource Brush.Code.Background}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MaxHeight" Value="{DynamicResource Layout.LogMaxHeight}" />
    <Setter Property="Padding" Value="{DynamicResource Layout.MultilinePadding}" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="Template" Value="{StaticResource TextBox.Code.Template}" />
  </Style>

  <!-- 聊天输入区无边框融合编辑器：嵌在一体式 MD3 浮起输入坞内，消除双层嵌套边框 -->
  <ControlTemplate x:Key="TextBox.Composer.Template" TargetType="{x:Type TextBox}">
    <Border Background="Transparent" BorderThickness="0" SnapsToDevicePixels="True">
      <ScrollViewer x:Name="PART_ContentHost"
                    Focusable="False"
                    Margin="{TemplateBinding Padding}"
                    HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                    VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
    </Border>
  </ControlTemplate>

  <Style x:Key="TextBox.Composer" TargetType="{x:Type TextBox}" BasedOn="{StaticResource TextBox.Multiline}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="2,2,2,4" />
    <Setter Property="MinHeight" Value="46" />
    <Setter Property="Template" Value="{StaticResource TextBox.Composer.Template}" />
  </Style>

  <!-- 填充剩余空间的多行编辑器（左右对照翻译等）：高度由父级 * 行决定，自适应拉伸不设硬编码大保底。 -->
  <Style x:Key="TextBox.Editor" TargetType="{x:Type TextBox}" BasedOn="{StaticResource TextBox.Multiline}">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MaxHeight" Value="{x:Static sys:Double.PositiveInfinity}" />
    <Setter Property="Padding" Value="{DynamicResource Layout.MultilinePadding}" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>

  <!-- =========================================================================
       输入区高度把手（聊天输入框顶部）：8px 拖拽条 + 居中短横线。
       默认中性色，悬停/拖动转 Accent；背景与前景成对切换，不使用 Opacity。
       ========================================================================= -->
  <Style x:Key="InputResizeGrip" TargetType="{x:Type Thumb}">
    <Setter Property="Height" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
    <Setter Property="Cursor" Value="SizeNS" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <Border x:Name="Handle"
                    Width="36" Height="3"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{TemplateBinding Foreground}"
                    CornerRadius="{StaticResource Radius.Small}"
                    SnapsToDevicePixels="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Control.Hover}" />
              <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Accent.Subtle}" />
              <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PasswordBox.Base" TargetType="{x:Type PasswordBox}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    <Setter Property="Background" Value="{StaticResource Brush.Control}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Control}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Height" Value="{DynamicResource Layout.ControlHeight}" />
    <Setter Property="MinHeight" Value="{DynamicResource Layout.ControlHeight}" />
    <Setter Property="Padding" Value="{DynamicResource Layout.InputPadding}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CaretBrush" Value="{StaticResource Brush.Text.Primary}" />
    <Setter Property="SelectionBrush" Value="{StaticResource Brush.Accent}" />
    <!-- 同上：模板已有 Accent 聚焦边框，不要再叠系统焦点框。 -->
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template" Value="{StaticResource PasswordBox.Template}" />
  </Style>

  <!-- =========================================================================
       复选框 / 单选框：16px 扁平指示器，勾选态用 Accent，禁用态显式换色。
       ========================================================================= -->
  <Style x:Key="CheckBox.Base" TargetType="{x:Type CheckBox}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,2,12,2" />
    <Setter Property="Cursor" Value="Hand" />
    <!-- 模板用 Box 边框表达键盘焦点，不再叠加系统焦点框。 -->
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type CheckBox}">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="Box"
                    Width="{StaticResource Layout.CheckBox.Size}"
                    Height="{StaticResource Layout.CheckBox.Size}"
                    VerticalAlignment="Center"
                    Background="{StaticResource Brush.Control}"
                    BorderBrush="{StaticResource Brush.Border.Control}"
                    BorderThickness="1"
                    CornerRadius="4"
                    SnapsToDevicePixels="True">
              <Grid>
                <!-- 对勾用填充多边形，不用细描边：16px 靶心下描边会发虚。
                     几何外包必须从 (0,0) 起、取偶数 10×8：Path 的 DesiredSize 取“到原点的外包”，
                     若从 3.4/3.4 起笔，居中对齐后整块墨迹会右下偏移。
                     内容区 14×14，居中偏移 (14-10)/2=2、(14-8)/2=3，
                     墨迹落在 2~12 / 3~11，四条 45° 边与臂端切面等宽，缩放后不歪不虚。 -->
                <Path x:Name="Check"
                      Data="M 0 4.5 L 3.5 8 L 10 1.5 L 8.5 0 L 3.5 5 L 1.5 3 Z"
                      Fill="{StaticResource Brush.OnAccent}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Visibility="Collapsed" />
                <Rectangle x:Name="Dash"
                           Width="8"
                           Height="2"
                           RadiusX="1"
                           RadiusY="1"
                           Fill="{StaticResource Brush.OnAccent}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed" />
              </Grid>
            </Border>
            <ContentPresenter x:Name="ContentSite"
                              Margin="8,0,0,0"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True"
                              TextElement.Foreground="{TemplateBinding Foreground}" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
              <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Focus}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.Accent}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
              <Setter TargetName="Check" Property="Visibility" Value="Visible" />
              <Setter TargetName="Dash" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsChecked" Value="{x:Null}">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.Accent}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
              <Setter TargetName="Check" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Dash" Property="Visibility" Value="Visible" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsChecked" Value="True" />
                <Condition Property="IsMouseOver" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.Accent.Hover}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Accent.Hover}" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsChecked" Value="{x:Null}" />
                <Condition Property="IsMouseOver" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.Accent.Hover}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Accent.Hover}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.Control.Disabled}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Border}" />
              <Setter TargetName="Check" Property="Fill" Value="{StaticResource Brush.Text.Disabled}" />
              <Setter TargetName="Dash" Property="Fill" Value="{StaticResource Brush.Text.Disabled}" />
              <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <!-- 无文字时去掉右侧内容间距，表头/单元格复选框保持 16px 靶心居中。 -->
      <Trigger Property="HasContent" Value="False">
        <Setter Property="Margin" Value="0" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="RadioButton.Base" TargetType="{x:Type RadioButton}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RadioButton}">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Grid Width="{StaticResource Layout.CheckBox.Size}"
                  Height="{StaticResource Layout.CheckBox.Size}"
                  VerticalAlignment="Center">
              <Ellipse x:Name="Ring"
                       Fill="{StaticResource Brush.Control}"
                       Stroke="{StaticResource Brush.Border.Control}"
                       StrokeThickness="1" />
              <Ellipse x:Name="Dot"
                       Width="6"
                       Height="6"
                       Fill="{StaticResource Brush.Accent}"
                       Visibility="Collapsed" />
            </Grid>
            <ContentPresenter x:Name="ContentSite"
                              Margin="8,0,0,0"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True"
                              TextElement.Foreground="{TemplateBinding Foreground}" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Brush.Accent}" />
              <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Brush.Accent}" />
              <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsChecked" Value="True" />
                <Condition Property="IsMouseOver" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Brush.Accent.Hover}" />
              <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Brush.Accent.Hover}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Ring" Property="Fill" Value="{StaticResource Brush.Control.Disabled}" />
              <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Brush.Border}" />
              <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Brush.Text.Disabled}" />
              <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- =========================================================================
       下拉框：与输入框、按钮同高（26），文字垂直居中
       ========================================================================= -->
  <!-- 可编辑下拉框的内嵌编辑框：外观由外层 ToggleButton 提供，这里只保留内容宿主。 -->
  <ControlTemplate x:Key="ComboBox.EditableTextBox.Template" TargetType="{x:Type TextBox}">
    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
  </ControlTemplate>

  <Style x:Key="ComboBox.Toggle" TargetType="{x:Type ToggleButton}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="ClickMode" Value="Press" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource Radius.Small}"
                  SnapsToDevicePixels="True">
            <Path x:Name="Arrow"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Margin="0,1,9,0"
                  Data="M 0,0 L 4,4 L 8,0"
                  Stroke="{StaticResource Brush.Text.Secondary}"
                  StrokeThickness="1.4"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource Brush.Text.Disabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 下拉项：选中只使用轻背景，不改文字颜色、不加粗。 -->
  <Style TargetType="{x:Type ComboBoxItem}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    <Setter Property="Padding" Value="{DynamicResource Layout.ListItemPadding}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBoxItem}">
          <Border x:Name="Bd"
                  Background="Transparent"
                  Margin="2,1,2,1"
                  Padding="{TemplateBinding Padding}"
                  CornerRadius="{StaticResource Radius.Small}">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Control.Hover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Selection}" />
              <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsSelected" Value="True" />
                <Condition Property="IsMouseOver" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Selection.Hover}" />
              <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Control.Disabled}" />
              <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ComboBox.Base" TargetType="{x:Type ComboBox}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    <Setter Property="Background" Value="{StaticResource Brush.Control}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Control}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Height" Value="{DynamicResource Layout.ControlHeight}" />
    <!-- 右侧 20 给下拉箭头留位，避免长文本压到箭头上。 -->
    <Setter Property="Padding" Value="{DynamicResource Layout.ComboBoxPadding}" />
    <Setter Property="Cursor" Value="Hand" />
    <!-- 模板在 IsKeyboardFocusWithin / IsDropDownOpen 时会把边框换成 Accent，不再需要系统焦点框。 -->
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBox}">
          <Grid>
            <ToggleButton x:Name="ToggleButton"
                          Style="{StaticResource ComboBox.Toggle}"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
            <ContentPresenter x:Name="ContentSite"
                              Margin="{TemplateBinding Padding}"
                              IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}" />
            <TextBox x:Name="PART_EditableTextBox"
                     Margin="{TemplateBinding Padding}"
                     Style="{x:Null}"
                     Template="{StaticResource ComboBox.EditableTextBox.Template}"
                     Visibility="Collapsed"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     Foreground="{TemplateBinding Foreground}"
                     CaretBrush="{TemplateBinding Foreground}"
                     SelectionBrush="{StaticResource Brush.Accent}"
                     VerticalContentAlignment="Center"
                     IsReadOnly="{TemplateBinding IsReadOnly}" />
            <Popup x:Name="PART_Popup"
                   AllowsTransparency="True"
                   Focusable="False"
                   IsOpen="{TemplateBinding IsDropDownOpen}"
                   Placement="Bottom"
                   PopupAnimation="Slide">
              <Border x:Name="DropDownBorder"
                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}"
                      Margin="0,3,0,0"
                      Padding="2"
                      Background="{StaticResource Brush.Panel}"
                      BorderBrush="{StaticResource Brush.Border.Strong}"
                      BorderThickness="1"
                      CornerRadius="{StaticResource Radius.Card}">
                <ScrollViewer SnapsToDevicePixels="True">
                  <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ToggleButton" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="ToggleButton" Property="BorderBrush" Value="{StaticResource Brush.Focus}" />
            </Trigger>
            <Trigger Property="IsDropDownOpen" Value="True">
              <Setter TargetName="ToggleButton" Property="BorderBrush" Value="{StaticResource Brush.Focus}" />
            </Trigger>
            <Trigger Property="IsEditable" Value="True">
              <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ToggleButton" Property="Background" Value="{StaticResource Brush.Control.Disabled}" />
              <Setter TargetName="ToggleButton" Property="BorderBrush" Value="{StaticResource Brush.Border}" />
              <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 小号下拉框（紧凑档 24 高，与工具条小按钮一致） -->
  <Style x:Key="ComboBox.Small" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource ComboBox.Base}">
    <Setter Property="Height" Value="{DynamicResource Layout.ControlHeight.Small}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
    <Setter Property="Padding" Value="{DynamicResource Layout.ComboBoxPadding}" />
  </Style>
</ResourceDictionary>
