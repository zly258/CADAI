<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>CadAI.Mcp.AutoCAD</RootNamespace>
    <AssemblyName>CadAI.Mcp.AutoCAD</AssemblyName>
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Deterministic>true</Deterministic>
    <DefineConstants>$(DefineConstants);AUTOCAD_MCP</DefineConstants>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
    <Compile Include="..\CadAI.Core\Compat\JavaScriptSerializerCompat.cs" Link="Compat\JavaScriptSerializerCompat.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="acdbmgd" Condition="Exists('$(AcadDir)acdbmgd.dll')">
      <HintPath>$(AcadDir)acdbmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acmgd" Condition="Exists('$(AcadDir)acmgd.dll')">
      <HintPath>$(AcadDir)acmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="accoremgd" Condition="Exists('$(AcadDir)accoremgd.dll')">
      <HintPath>$(AcadDir)accoremgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\CadAI.Core\Agent\ExchangeStore.cs" Link="Core\ExchangeStore.cs" />
    <Compile Include="..\CadAI.Core\Office\ExcelDocumentService.cs" Link="Office\ExcelDocumentService.cs" />
    <Compile Include="..\CadAI.Core\Office\PdfDocumentService.cs" Link="Office\PdfDocumentService.cs" />
    <Compile Include="..\CadAI.Core\Agent\PdfTextExtractor.cs" Link="Office\PdfTextExtractor.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CadAI.Host.AutoCAD" />
  </ItemGroup>
</Project>
