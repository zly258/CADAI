<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================================
     AutoCAD 自动加载清单（Autodesk ApplicationPlugins Bundle）
     规范位置：C:\Program Files\Autodesk\ApplicationPlugins\CADAI.bundle\
     适用版本：AutoCAD / Plant 3D 2019 ~ 2026+（R23.0 及以上全系列自适应）
     ============================================================================ -->
<ApplicationPackage SchemaVersion="1.0"
                    AutodeskProduct="AutoCAD"
                    ProductType="Application"
                    Name="CADAI"
                    NameChs="CADAI 智能助手"
                    AppVersion="1.0.0"
                    FriendlyVersion="1.0.0"
                    Description="CADAI - Open-source AI Chat, ModalAgent Watchdog, and MCP Toolset for Autodesk AutoCAD."
                    DescriptionChs="CADAI 智能助手：开源 AutoCAD AI 对话、弹窗看门狗与 MCP 工具套件"
                    Author="zly258"
                    ProductCode="{C4D41A10-7B3E-4F21-9A62-8E1D3B5F7A01}"
                    UpgradeCode="{C4D41A10-7B3E-4F21-9A62-8E1D3B5F7A02}">

  <CompanyDetails Name="zly258" Phone=" " Url="https://github.com/zly258/CADAI" Email=""/>
  <RuntimeRequirements OS="Win64" Platform="AutoCAD*" SeriesMin="R23.0"/>

  <!-- 1. AutoCAD 2019-2024 (R23.0-R24.3, .NET Framework 4.8) -->
  <Components Description="AutoCAD 2019-2024 - Win64 (.NET Framework 4.8)">
    <RuntimeRequirements OS="Win64" Platform="AutoCAD*" SeriesMin="R23.0" SeriesMax="R24.3"/>
    <ComponentEntry AppName="CADAI"
                    Version="1.0.0"
                    ModuleName="./Contents/net48/CadAI.Host.AutoCAD.dll"
                    AppDescription="CADAI: AI Chat, ModalAgent, and MCP Tools for AutoCAD (2019-2024)"
                    LoadOnAutoCADStartup="True"
                    LoadOnCommandInvocation="True">
      <Commands GroupName="CADAI_CMDS">
        <Command Global="CADCHAT"      Local="CADCHAT"/>
        <Command Global="CADCHATCFG"   Local="CADCHATCFG"/>
        <Command Global="CADWORKSPACE" Local="CADWORKSPACE"/>
        <Command Global="CADABOUT"     Local="CADABOUT"/>
        <Command Global="CADRIBBON"    Local="CADRIBBON"/>
      </Commands>
    </ComponentEntry>
  </Components>

  <!-- 2. AutoCAD 2025-2026+ (R25.0+, .NET 8.0) -->
  <Components Description="AutoCAD 2025-2026 - Win64 (.NET 8.0)">
    <RuntimeRequirements OS="Win64" Platform="AutoCAD*" SeriesMin="R25.0"/>
    <ComponentEntry AppName="CADAI"
                    Version="1.0.0"
                    ModuleName="./Contents/net8.0-windows/CadAI.Host.AutoCAD.dll"
                    AppDescription="CADAI: AI Chat, ModalAgent, and MCP Tools for AutoCAD (2025-2026)"
                    LoadOnAutoCADStartup="True"
                    LoadOnCommandInvocation="True">
      <Commands GroupName="CADAI_CMDS">
        <Command Global="CADCHAT"      Local="CADCHAT"/>
        <Command Global="CADCHATCFG"   Local="CADCHATCFG"/>
        <Command Global="CADWORKSPACE" Local="CADWORKSPACE"/>
        <Command Global="CADABOUT"     Local="CADABOUT"/>
        <Command Global="CADRIBBON"    Local="CADRIBBON"/>
      </Commands>
    </ComponentEntry>
  </Components>
</ApplicationPackage>
