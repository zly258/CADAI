<Window x:Class="CadAI.Host.AutoCAD.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:CadAI.Core;assembly=CadAI.Core"
        Style="{DynamicResource Window.Base}"
        Title="关于 CADAI"
        Width="460"
        MinWidth="420"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/CadAI.Core;component/UI/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部：图标 + 名称与版本 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,14">
            <Border Width="40" Height="40" CornerRadius="12"
                    Background="{StaticResource Brush.Accent.Subtle}"
                    BorderBrush="{StaticResource Brush.Border.Strong}"
                    BorderThickness="1"
                    Margin="0,0,12,0">
                <core:MaterialIcon Symbol="auto_awesome" Width="22" Height="22" Foreground="{StaticResource Brush.Focus}"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="ProductNameText" Style="{StaticResource Text.Title}" FontSize="{StaticResource FontSize.Display}" FontWeight="SemiBold" Text="CADAI"/>
                <TextBlock x:Name="VersionText" Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- 中部：简洁元信息卡片（描述 / 开发者 / 开源地址 / 开源协议） -->
        <Border Grid.Row="1" Style="{StaticResource Card.Base}" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="DescLabel" Grid.Row="0" Grid.Column="0" Text="描述" Style="{StaticResource Text.Caption}" VerticalAlignment="Top" Margin="0,0,0,10"/>
                <TextBlock x:Name="DescriptionText" Grid.Row="0" Grid.Column="1" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                <TextBlock x:Name="DevLabel" Grid.Row="1" Grid.Column="0" Text="开发者" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock x:Name="DeveloperText" Grid.Row="1" Grid.Column="1" Style="{StaticResource Text.Body}"
                           Foreground="{StaticResource Brush.Focus}" Cursor="Hand" Margin="0,0,0,10"
                           MouseLeftButtonUp="DeveloperText_Click" ToolTip="打开开发者 GitHub 主页"/>

                <TextBlock x:Name="RepoLabel" Grid.Row="2" Grid.Column="0" Text="项目地址" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock x:Name="RepoUrlText" Grid.Row="2" Grid.Column="1" Style="{StaticResource Text.Body}"
                           Foreground="{StaticResource Brush.Focus}" Cursor="Hand" Margin="0,0,0,10"
                           MouseLeftButtonUp="RepoUrlText_Click" ToolTip="在浏览器中打开 GitHub 仓库"/>

                <TextBlock x:Name="SponsorLabel" Grid.Row="3" Grid.Column="0" Text="赞助支持" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock x:Name="SponsorText" Grid.Row="3" Grid.Column="1" Style="{StaticResource Text.Body}"
                           Foreground="{StaticResource Brush.Focus}" Cursor="Hand" Margin="0,0,0,10"
                           MouseLeftButtonUp="SponsorText_Click" ToolTip="通过爱发电支持项目持续维护"/>

                <TextBlock x:Name="LicenseLabel" Grid.Row="4" Grid.Column="0" Text="开源协议" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
                <TextBlock x:Name="LicenseText" Grid.Row="4" Grid.Column="1" Style="{StaticResource Text.Body}"/>
            </Grid>
        </Border>

        <!-- 底部：关闭按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CloseButton"
                    Style="{StaticResource Button.Primary}"
                    Content="关闭"
                    IsDefault="True"
                    IsCancel="True"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
