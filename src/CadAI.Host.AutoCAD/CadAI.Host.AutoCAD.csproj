<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>CadAI.Host.AutoCAD</RootNamespace>
    <AssemblyName>CadAI.Host.AutoCAD</AssemblyName>
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="acdbmgd" Condition="Exists('$(AcadDir)acdbmgd.dll')">
      <HintPath>$(AcadDir)acdbmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acmgd" Condition="Exists('$(AcadDir)acmgd.dll')">
      <HintPath>$(AcadDir)acmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="accoremgd" Condition="Exists('$(AcadDir)accoremgd.dll')">
      <HintPath>$(AcadDir)accoremgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AdWindows" Condition="Exists('$(AcadDir)AdWindows.dll')">
      <HintPath>$(AcadDir)AdWindows.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CadAI.Core\CadAI.Core.csproj">
      <Private>true</Private>
    </ProjectReference>
    <ProjectReference Include="..\CadAI.Mcp.AutoCAD\CadAI.Mcp.AutoCAD.csproj">
      <Private>true</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="DwgChat\Hosting\SystemPrompt.AutoCad.txt">
      <LogicalName>AutoCADAI.SystemPrompt.AutoCad.txt</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="DwgChat\Hosting\Welcome.AutoCad.txt">
      <LogicalName>AutoCADAI.Welcome.AutoCad.txt</LogicalName>
    </EmbeddedResource>
    <None Include="DwgChat\cadai.runtime.json">
      <Link>cadai.runtime.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Windows\About.AutoCad.md">
      <Link>About.AutoCad.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\skills\dwgai\**\*.*">
      <Link>skills\dwgai\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
